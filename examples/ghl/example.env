# ~/.ghl/<account>.env  — one sub-account profile.
# Copy this to ~/.ghl/<yourname>.env (the filename, minus .env, is the profile
# name you pass to `ghl-as`). Selectable immediately via `ghl-as <yourname>`.

GHL_LABEL="Example Account"   # optional friendly name shown in the picker
GHL_AGENCY=ascend             # -> ~/.ghl/agencies/ascend.env supplies the Firebase token
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # this sub-account's Private Integration Token
GHL_LOCATION_ID=locationid    # this sub-account's Location ID (long string in the GHL URL)
